generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  OPERATOR
  VIEWER
}

enum LocationType {
  RECEIVING
  STORAGE
  PICKING
  PACKING
  SHIPPING
  RETURNS
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED
}

enum ShipmentStatus {
  READY
  PICKING
  PACKED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum StockCountStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}
model User {
  id           String          @id @default(uuid())
  name         String
  username     String?         @unique
  email        String          @unique
  passwordHash String
  role         UserRole        @default(OPERATOR)
  isActive     Boolean         @default(true)
  movements StockMovement[] @relation("StockMovementCreatedBy")
  shipmentEvents ShipmentEvent[] @relation("ShipmentEventCreatedBy")
  goodsReceipts GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  createdStockCounts StockCount[] @relation("StockCountCreatedBy")
  approvedStockCounts StockCount[] @relation("StockCountApprovedBy")
  stockCountEvents StockCountEvent[] @relation("StockCountEventActor")
  sessions AuthSession[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SystemSetting {
  id        String   @id @default("global")
  value     Json
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  address        String?
  locations      WarehouseLocation[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  stockCounts StockCount[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model WarehouseLocation {
  id           String          @id @default(uuid())
  warehouseId  String
  code         String
  name         String?
  type         LocationType    @default(STORAGE)
  zone         String?
  aisle        String?
  rack         String?
  shelf        String?
  bin          String?
  capacity     Decimal?        @db.Decimal(12, 3)
  isActive     Boolean         @default(true)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  inventory    Inventory[]
  outgoing     StockMovement[] @relation("MovementFrom")
  incoming     StockMovement[] @relation("MovementTo")
  shipmentItems ShipmentItem[]
  goodsReceiptItems GoodsReceiptItem[]
  stockCounts StockCount[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([warehouseId, code])
}

model Product {
  id                String             @id @default(uuid())
  sku               String             @unique
  productCode       String?            @unique
  barcode           String?            @unique
  name              String
  description       String?
  category          String?
  brand             String?
  unit              String             @default("PCS")
  costPrice         Decimal?           @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  minimumStock      Decimal?           @db.Decimal(12, 3)
  maximumStock      Decimal?           @db.Decimal(12, 3)
  isActive          Boolean            @default(true)
  inventory         Inventory[]
  movements         StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  salesOrderItems   SalesOrderItem[]
  stockCountItems StockCountItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Inventory {
  id         String            @id @default(uuid())
  productId  String
  locationId String
  quantity   Decimal           @default(0) @db.Decimal(12, 3)
  reserved   Decimal           @default(0) @db.Decimal(12, 3)
  product    Product           @relation(fields: [productId], references: [id])
  location   WarehouseLocation @relation(fields: [locationId], references: [id])
  reservations InventoryReservation[]
  updatedAt  DateTime          @updatedAt

  @@unique([productId, locationId])
}

model Supplier {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  taxNumber      String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Customer {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  taxNumber     String?
  isActive      Boolean      @default(true)
  salesOrders   SalesOrder[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  orderNumber      String              @unique
  supplierId       String
  warehouseId      String
  status           PurchaseOrderStatus @default(DRAFT)
  expectedDelivery DateTime?
  notes            String?
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(12, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  unitCost         Decimal       @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]
  product          Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id             String             @id @default(uuid())
  grnNumber      String             @unique
  idempotencyKey String             @unique
  purchaseOrderId String
  receivedById   String
  receivedAt     DateTime           @default(now())
  note           String?
  purchaseOrder  PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  receivedBy     User               @relation("GoodsReceiptCreatedBy", fields: [receivedById], references: [id])
  items          GoodsReceiptItem[]
  createdAt      DateTime           @default(now())

  @@index([purchaseOrderId, receivedAt])
}

model GoodsReceiptItem {
  id                 String             @id @default(uuid())
  goodsReceiptId     String
  purchaseOrderItemId String
  productId          String
  locationId         String
  quantity           Decimal            @db.Decimal(12, 3)
  unitCost           Decimal            @db.Decimal(12, 2)
  goodsReceipt       GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem  PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])
  product            Product            @relation(fields: [productId], references: [id])
  location           WarehouseLocation  @relation(fields: [locationId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId, locationId])
}
model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  customerId  String
  warehouseId String
  status      SalesOrderStatus @default(DRAFT)
  notes       String?
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  items       SalesOrderItem[]
  shipments   Shipment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
}

model SalesOrderItem {
  id              String         @id @default(uuid())
  salesOrderId    String
  productId       String
  quantity        Decimal        @db.Decimal(12, 3)
  shippedQuantity Decimal        @default(0) @db.Decimal(12, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  shipmentItems   ShipmentItem[]
  reservations InventoryReservation[]

  @@index([salesOrderId])
}

model InventoryReservation {
  id              String         @id @default(uuid())
  salesOrderItemId String
  inventoryId     String
  quantity        Decimal        @db.Decimal(12, 3)
  fulfilledQuantity Decimal @default(0) @db.Decimal(12, 3)
  releasedAt      DateTime?
  salesOrderItem  SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  inventory       Inventory      @relation(fields: [inventoryId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([salesOrderItemId, releasedAt])
  @@index([inventoryId, releasedAt])
}

model Shipment {
  id               String         @id @default(uuid())
  shipmentNumber   String         @unique
  salesOrderId     String
  status           ShipmentStatus @default(READY)
  fulfillmentRequired Boolean @default(false)
  carrier          String?
  trackingNumber   String?
  packageCount     Int            @default(1)
  shippingAddress  String?
  expectedDelivery DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items            ShipmentItem[]
  events ShipmentEvent[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
}

model ShipmentEvent {
  id          String         @id @default(uuid())
  shipmentId  String
  fromStatus  ShipmentStatus?
  toStatus    ShipmentStatus
  note        String?
  operationKey String? @unique
  createdById String?
  shipment    Shipment      @relation(fields: [shipmentId], references: [id])
  createdBy   User?         @relation("ShipmentEventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([shipmentId, createdAt])
}
model ShipmentItem {
  id               String            @id @default(uuid())
  shipmentId       String
  salesOrderItemId String
  locationId       String
  quantity         Decimal           @db.Decimal(12, 3)
  pickedQuantity   Decimal           @default(0) @db.Decimal(12, 3)
  packedQuantity   Decimal           @default(0) @db.Decimal(12, 3)
  shipment         Shipment          @relation(fields: [shipmentId], references: [id])
  salesOrderItem   SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id])
  location         WarehouseLocation @relation(fields: [locationId], references: [id])

  @@index([shipmentId])
}

model StockCount {
  id           String           @id @default(uuid())
  countNumber  String           @unique
  warehouseId  String
  locationId   String
  createdById  String
  approvedById String?
  status       StockCountStatus @default(OPEN)
  note         String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  postedAt     DateTime?
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  location     WarehouseLocation @relation(fields: [locationId], references: [id])
  createdBy    User               @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?              @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  items        StockCountItem[]
  events       StockCountEvent[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([warehouseId, locationId])
}

model StockCountItem {
  id              String       @id @default(uuid())
  stockCountId    String
  productId       String
  bookQuantity    Decimal      @db.Decimal(12, 3)
  countedQuantity Decimal?     @db.Decimal(12, 3)
  variance        Decimal?     @db.Decimal(12, 3)
  stockCount      StockCount   @relation(fields: [stockCountId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
  @@index([productId])
}

model StockCountEvent {
  id           String           @id @default(uuid())
  stockCountId String
  fromStatus   StockCountStatus?
  toStatus     StockCountStatus
  actorId      String
  note         String?
  createdAt    DateTime         @default(now())
  stockCount   StockCount       @relation(fields: [stockCountId], references: [id])
  actor        User             @relation("StockCountEventActor", fields: [actorId], references: [id])

  @@index([stockCountId, createdAt])
}
model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  warehouseId    String
  fromLocationId String?
  toLocationId   String?
  createdById    String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  reference      String?
  operationKey   String?           @unique
  note           String?
  product        Product           @relation(fields: [productId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  fromLocation   WarehouseLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation     WarehouseLocation? @relation("MovementTo", fields: [toLocationId], references: [id])
  createdBy      User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
}
